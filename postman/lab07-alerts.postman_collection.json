{
  "info": {
    "name": "Lab07 alerts - recovered real API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run only with load stopped and after failure recovery. Keeps its one project/task as evidence. Raw business counter increments once after201 and ignores400/404. Real local API/Prometheus; no mocks. A fresh process may not export the lazy service counter until its first creation; only the initial read treats absence as zero. Reads after successful creation must contain the actual metric."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8088"
    },
    {
      "key": "promUrl",
      "value": "http://localhost:9090"
    }
  ],
  "item": [
    {
      "name": "Ready restored",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health/ready"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Ready 200',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Counter before",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/metrics"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Metrics 200',()=>pm.response.to.have.status(200));",
              "const line=pm.response.text().split('\\n').find(x=>x.startsWith('demo_tasks_created_total ')); const value=line ? Number(line.split(/\\s+/)[1]) : 0;",
              "pm.test('Counter finite',()=>pm.expect(Number.isFinite(value)).to.eql(true)); pm.collectionVariables.set('beforeCounter',String(value));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create counter project",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/projects",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"lab14-postman-{{$guid}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Project 201',()=>pm.response.to.have.status(201)); pm.collectionVariables.set('projectId',String(pm.response.json().id));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create counted task",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/tasks",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"projectId\": {{projectId}}, \"title\": \"business counter smoke\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Task 201',()=>pm.response.to.have.status(201)); pm.test('Todo persisted',()=>pm.expect(pm.response.json().status).to.eql('Todo'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Counter incremented",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/metrics"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Metrics 200',()=>pm.response.to.have.status(200));",
              "const line=pm.response.text().split('\\n').find(x=>x.startsWith('demo_tasks_created_total ')); pm.expect(line).to.exist; const value=Number(line.split(/\\s+/)[1]);",
              "pm.test('Exactly one persisted event',()=>pm.expect(value).to.eql(Number(pm.collectionVariables.get('beforeCounter'))+1));"
            ]
          }
        }
      ]
    },
    {
      "name": "Rejected empty title",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/tasks",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"projectId\": {{projectId}}, \"title\": \"\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Invalid task 400',()=>pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Missing project",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/tasks",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"projectId\": 2147483647, \"title\": \"missing\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Unknown project 404',()=>pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "Counter unchanged by rejected requests",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/metrics"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Metrics 200',()=>pm.response.to.have.status(200));",
              "const line=pm.response.text().split('\\n').find(x=>x.startsWith('demo_tasks_created_total ')); pm.expect(line).to.exist; const value=Number(line.split(/\\s+/)[1]);",
              "pm.test('Rejected operations not counted',()=>pm.expect(value).to.eql(Number(pm.collectionVariables.get('beforeCounter'))+1));"
            ]
          }
        }
      ]
    },
    {
      "name": "Targets recovered",
      "request": {
        "method": "GET",
        "url": "{{promUrl}}/api/v1/targets"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Targets 200',()=>pm.response.to.have.status(200)); const targets=pm.response.json().data.activeTargets; pm.test('Three targets UP',()=>{pm.expect(targets.length).to.eql(3); targets.forEach(t=>pm.expect(t.health).to.eql('up'));});"
            ]
          }
        }
      ]
    },
    {
      "name": "Rules ready",
      "request": {
        "method": "GET",
        "url": "{{promUrl}}/api/v1/rules?type=alert"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Rules 200',()=>pm.response.to.have.status(200)); const rules=pm.response.json().data.groups.flatMap(g=>g.rules); pm.test('Five rules healthy',()=>{pm.expect(rules.length).to.eql(5); rules.forEach(r=>pm.expect(r.health).to.eql('ok'));}); pm.test('Availability alert cleared',()=>pm.expect(rules.find(r=>r.name==='ApiDown').state).to.eql('inactive'));"
            ]
          }
        }
      ]
    }
  ]
}
