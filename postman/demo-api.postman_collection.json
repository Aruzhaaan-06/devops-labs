              "mode": "raw",
              "raw": "{\n  \"name\": \"{{projectName}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const uniqueName = \"lab01-part1-\" + pm.variables.replaceIn(\"{{$guid}}\");",
                  "pm.collectionVariables.set(\"projectName\", uniqueName);",
                  "pm.variables.set(\"projectName\", uniqueName);",
                  "pm.collectionVariables.unset(\"projectId\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"ID проекта сохранён\", function () { const body = pm.response.json(); pm.expect(body.id).to.be.a(\"number\").above(0); pm.collectionVariables.set(\"projectId\", body.id); pm.variables.set(\"projectId\", body.id); });",
                  "pm.test(\"Location указывает на проект\", function () { pm.expect(pm.response.headers.get(\"Location\")).to.match(new RegExp(\"/api/projects/\" + pm.collectionVariables.get(\"projectId\") + \"$\")); });",
                  "pm.test(\"Название проекта сохранено\", function () { pm.expect(pm.response.json().name).to.eql(pm.collectionVariables.get(\"projectName\")); });"
                ]
              }
            }
