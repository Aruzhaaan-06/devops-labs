# Жергілікті Docker Compose жұмысы үшін .env файлына көшіріңіз.
# Жеке құпиясөз орнатыңыз; толтырылған .env файлын Git-ке қоспаңыз.
DB_PASSWORD=
DB_PORT=15432
API_PORT=8088
ADMINER_PORT=8083
API_IMAGE=devops-labs-demo-api
API_TAG=local
# Ауқым басқа жергілікті желімен қиылысса, бос ішкі желіні таңдаңыз.
COMPOSE_SUBNET=10.254.54.0/24
